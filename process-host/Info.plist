<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>ProcessHost</string>
	<key>CFBundleIdentifier</key>
	<string>dev.local.maciOS.ProcessHost</string>
	<key>CFBundleName</key>
	<string>ProcessHost</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!--
	com.apple.ar.viewer is a real, ordinary system extension point (AR Quick
	Look). It is used here for a property its XPCService dict is allowed to
	carry that most extension points are not: _MultipleInstances lets this
	one declared extension be launched as more than one CONCURRENT process
	at a time (an ordinary extension point gives you a singleton instance),
	and _ProcessType "App" gives each of those instances RunningBoard's
	app-class memory/CPU/jetsam limits instead of the much tighter
	extension-class ones. FALSEPREDICATE means the real AR Quick Look flow
	never activates it -- it is only ever invoked programmatically, by this
	app's own code requesting this extension by identifier. See
	docs/process-host.md for where this recipe comes from (LiveContainer's
	LiveProcess component) and why it answers the posix_spawn/EPERM wall
	documented in AUDIT.md: this gets a genuine separate, separately
	scheduled OS process without ever calling exec/posix_spawn, by asking
	iOS's own extension-launch machinery to create one instead.
	-->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>NSExtensionActivationRule</key>
			<string>FALSEPREDICATE</string>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.ar.viewer</string>
		<key>NSExtensionPrincipalClass</key>
		<string>ProcessHostHandler</string>
	</dict>
	<key>XPCService</key>
	<dict>
		<key>ServiceType</key>
		<string>Application</string>
		<key>_MultipleInstances</key>
		<true/>
		<key>_ProcessType</key>
		<string>App</string>
	</dict>
</dict>
</plist>
